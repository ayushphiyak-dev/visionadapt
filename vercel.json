{
  "version": 2,
  "name": "visionadapt",
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 10
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "model_weights.json",
      "use": "@vercel/static"
    },
    {
      "src": "metrics.json",
      "use": "@vercel/static"
    },
    {
      "src": "extension/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/extension/(.*)",
      "dest": "/extension/$1"
    },
    {
      "src": "/(.*\\.(html|css|js|json|png|ico|svg|woff|woff2|ttf|txt|md|yml))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
