{
  "manifest_version": 3,
  "name": "VisionAdapt",
  "version": "1.0.0",
  "description": "Real-time color correction for online games. Intercepts WebGL/Canvas rendering and applies personalized CVD correction via GPU shaders. Works on Krunker, Shell Shockers, Slope, 1v1.LOL, and any canvas-based game.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VisionAdapt — Game Color Correction"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
